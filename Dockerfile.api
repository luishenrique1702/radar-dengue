FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.29" "pandas>=2.2" "pyarrow>=15"
COPY src/radar_dengue/ src/radar_dengue/
COPY data/processed/previsao_atual.parquet data/processed/
COPY data/geo/ data/geo/
COPY models/metricas.json models/
ENV PYTHONPATH=/app/src
EXPOSE 8000
CMD ["uvicorn", "radar_dengue.api:app", "--host", "0.0.0.0", "--port", "8000"]
